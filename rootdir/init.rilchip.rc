# Secondary Samsung RIL for SM-J250F dual SIM.
service ril-daemon1 /system/bin/rild -l /system/lib/libsec-ril-dsds.so -c 2
    class main
    socket rild2 stream 660 root radio
    socket rild-debug2 stream 660 radio system
    user root
    group radio cache inet misc audio log qcom_diag system drmrpc sdcard_r sdcard_rw shell readproc
    disabled

on property:persist.radio.multisim.config=dsds
    start ril-daemon1

on property:persist.radio.multisim.config=ss
    stop ril-daemon1
